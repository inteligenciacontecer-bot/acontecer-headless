# ──────────────────────────────────────────────────────────────────────────────
# /etc/fail2ban/jail.local — Acontecer.co.cr
# Creado: 2026-05-15
# ──────────────────────────────────────────────────────────────────────────────

[DEFAULT]
# IPs que NUNCA se banean: localhost + rangos Cloudflare (safety net)
# Con real_ip_module activo, los logs ya muestran IPs reales,
# pero dejamos Cloudflare en whitelist por si acaso.
ignoreip = 127.0.0.1/8 ::1
           173.245.48.0/20
           103.21.244.0/22
           103.22.200.0/22
           103.31.4.0/22
           141.101.64.0/18
           108.162.192.0/18
           190.93.240.0/20
           188.114.96.0/20
           197.234.240.0/22
           198.41.128.0/17
           162.158.0.0/15
           104.16.0.0/13
           104.24.0.0/14
           172.64.0.0/13
           131.0.72.0/22
           2400:cb00::/32
           2606:4700::/32
           2803:f800::/32
           2405:b500::/32
           2405:8100::/32
           2a06:98c0::/29
           2c0f:f248::/32

# Configuración base
bantime  = 3600       ; 1 hora por defecto
findtime = 600        ; ventana de 10 minutos
maxretry = 5

banaction = ufw       ; usa UFW para banear (más limpio que iptables directo)

# ── SSH (ya existía, lo reforzamos) ──────────────────────────────────────────
[sshd]
enabled  = true
port     = ssh
maxretry = 4
findtime = 300
bantime  = 7200       ; 2 horas para SSH

# ── WP-Login / xmlrpc.php ─────────────────────────────────────────────────────
# Cualquier toque a wp-login.php o xmlrpc.php = ban inmediato extendido.
# Máximo 3 intentos en 5 minutos → ban 24 horas.
[nginx-wp-auth]
enabled  = true
port     = http,https
filter   = nginx-wp-auth
logpath  = /var/log/nginx/access.log
           /var/log/nginx/acontecer.co.cr-access.log
maxretry = 3
findtime = 300        ; 5 minutos
bantime  = 86400      ; 24 horas

# ── Bots escaneando rutas inexistentes (404 scanner) ─────────────────────────
# Usa el filtro nginx-botsearch incluido con fail2ban.
# 10 errores 404 en 2 minutos → ban 6 horas.
[nginx-botsearch]
enabled  = true
port     = http,https
filter   = nginx-botsearch
logpath  = /var/log/nginx/access.log
           /var/log/nginx/acontecer.co.cr-access.log
maxretry = 10
findtime = 120        ; 2 minutos
bantime  = 21600      ; 6 horas

# ── Bad requests (peticiones HTTP malformadas) ────────────────────────────────
[nginx-bad-request]
enabled  = true
port     = http,https
filter   = nginx-bad-request
logpath  = /var/log/nginx/access.log
           /var/log/nginx/acontecer.co.cr-access.log
maxretry = 5
findtime = 300
bantime  = 7200       ; 2 horas

# ── Reincidentes (meta-jail) ──────────────────────────────────────────────────
# Si una IP fue baneada 3 veces en un día → ban de 1 semana.
[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
filter   = recidive
maxretry = 3
findtime = 86400      ; 1 día
bantime  = 604800     ; 1 semana
